# ==========================
# Application
# ==========================
APP_NAME=Vetino API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ==========================
# API
# ==========================
API_V1_PREFIX=/api/v1

# ==========================
# Security
# ==========================
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================
# Database
# ==========================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vetino
POSTGRES_USER=vetino
POSTGRES_PASSWORD=change_me

# ==========================
# CORS
# ==========================
BACKEND_CORS_ORIGINS=http://localhost:3000